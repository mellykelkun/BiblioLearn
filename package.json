{
  "name": "bibliolearn",
  "version": "1.0.0",
  "private": true,
  "description": "Bibliothèque locale et évolutive pour apprendre le développement et pratiquer sur plusieurs langages",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch server.js --watch src server.js",
    "build:catalogue": "node scripts/construire-catalogue.js",
    "check": "node scripts/construire-catalogue.js && node scripts/verifier-syntaxe.js && node scripts/verifier-catalogue.js && node scripts/auditer-parcours.js && node scripts/test-pedagogie.js && node --test tests/*.test.mjs",
    "generate:migration": "node scripts/generer-migration.js",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "audit:editorial": "node scripts/auditer-editorial.js",
    "audit:parcours": "node scripts/auditer-parcours.js",
    "measure": "node scripts/mesurer-performance.mjs",
    "check:syntax": "node scripts/verifier-syntaxe.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "nodemon": "^3.1.14"
  }
}
